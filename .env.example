# だんごツール（Next.js）用の環境変数テンプレート
# 使い方: このファイルをコピーして `.env.local` を作成し、必要な行のコメントを外して値を設定してください。
# `.env.local` は Git に含めません（`.env.example` のみコミット対象です）。

# ---------------------------------------------------------------------------
# 任意: 利用状況の送信先（Cloudflare Worker のベース URL など）
# 未設定のときは AnalyticsSender は何も送信しません。
# 詳細: docs/concept-and-architecture.md / my-worker/README.md
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://your-worker.example.workers.dev

# ---------------------------------------------------------------------------
# 任意: ガチャの画像・音声アップロード API（Worker のベース URL）
# NEXT_PUBLIC_UPLOAD_API_URL=https://your-worker.example.workers.dev

# ---------------------------------------------------------------------------
# 任意: Google ドライブ連携（/sync の「Googleで連携」用）
# Google Cloud Console で OAuth 2.0 クライアント ID（種別: ウェブアプリケーション）を作成し、
# 「承認済みの JavaScript 生成元」に本番 URL とローカル（例: http://localhost:3000）を追加してください。
# クライアントシークレットはフロントに置かず、公開されるのはこのクライアント ID のみです。
# 未設定のときは Google 連携タブは「未設定」の案内表示になります。
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
